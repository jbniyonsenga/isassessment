# SMTP used to email PDF reports. In development, when SMTP_HOST is empty, emails are
# not sent (JSON transport). In production, email delivery is disabled (503) without it.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); defaults to STARTTLS otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IT System Quick Audit <no-reply@example.com>"

# Indicative score thresholds "strong,moderate" in percent (default 80,50)
NEXT_PUBLIC_SCORE_THRESHOLDS=80,50
