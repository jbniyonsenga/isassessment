# PostgreSQL connection (on Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:password@localhost:5432/isassessment?schema=public"

# Email provider for PDF reports: RESEND_API_KEY (HTTPS API, required on Railway
# Hobby where SMTP is blocked) or SMTP_*. In development with neither, emails are not
# sent (JSON transport). In production, email delivery is disabled (503) without one.
RESEND_API_KEY=
MAIL_FROM="IT System Quick Audit <no-reply@example.com>"

SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); defaults to STARTTLS otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Indicative score thresholds "strong,moderate" in percent (default 80,50)
NEXT_PUBLIC_SCORE_THRESHOLDS=80,50
